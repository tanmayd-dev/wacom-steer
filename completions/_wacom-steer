#compdef wacom-steer

autoload -U is-at-least

_wacom-steer() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Path to TOML configuration file]:PATH:_files' \
'--device=[Path to input event device (e.g. /dev/input/event7)]:PATH:_files' \
'--device-name=[Substring to match against device name]:TEXT:_default' \
'--vendor=[Device USB vendor ID in hex (e.g. 056a)]:HEX:_default' \
'--product=[Device USB product ID in hex (e.g. 0375)]:HEX:_default' \
'--center=[Normalized tablet center position \[0.0..1.0\] (default\: 0.5)]:F:_default' \
'--half-span=[Normalized tablet half-span \[> 0.0..1.0\] (default\: 0.5)]:F:_default' \
'--deadzone=[Deadzone around center \[0.0..1.0) (default\: 0.0)]:F:_default' \
'--curve=[Exponential curve factor (> 0.0, 1.0 = linear) (default\: 1.0)]:F:_default' \
'--steering-mode=[Steering mode\: absolute (default) or relative]:absolute|relative:((absolute\:"Hardware stylus position directly sets steering angle (default)"
relative\:"Stylus deflection commands turn rate, auto-centering when returned to resting position"))' \
'--relative-turn-rate=[Full lock sweeps per second at full deflection in relative mode (default\: 2.0)]:F:_default' \
'--relative-return-rate=[Auto-centering rate in relative mode (default\: 3.0)]:F:_default' \
'--relative-deadzone=[Resting deadzone around center in relative mode (default\: 0.05)]:F:_default' \
'--recenter-button=[Recenter button\: none (default), btn_stylus, btn_stylus2, btn_0..btn_9, or hex code]:NAME|HEX:_default' \
'--pedal-mode=[Pedal mode for stylus Y-axis\: off (default), split, combined]:off|split|combined:((off\:"Stylus Y-axis is disabled / ignored (default)"
split\:"Split triggers\: forward = throttle (ABS_RZ), backward = brake (ABS_Z)"
combined\:"Combined stick axis\: ABS_Y (forward = positive/throttle, backward = negative/brake)"))' \
'--pedal-center=[Normalized tablet center for pedal Y-axis \[0.0..1.0\] (default\: 0.5)]:F:_default' \
'--pedal-half-span=[Normalized tablet half-span for pedal Y-axis \[> 0.0..1.0\] (default\: 0.5)]:F:_default' \
'--pedal-deadzone=[Neutral coasting deadzone for pedals \[0.0..1.0) (default\: 0.05)]:F:_default' \
'--pedal-curve=[Exponential curve factor for pedals (> 0.0, 1.0 = linear) (default\: 1.0)]:F:_default' \
'--lift=[Pen lift behavior\: center or hold (default\: center)]:center|hold:((center\:"Center steering immediately when pen is lifted (default)"
hold\:"Hold the last steering angle when pen is lifted"))' \
'--log-level=[Log level\: trace, debug, info, warn, error (default\: info)]:trace|debug|info|warn|error:(trace debug info warn error)' \
'--completions=[Generate shell completion script and exit (e.g. zsh, bash, fish)]:SHELL:(bash elvish fish powershell zsh)' \
'--invert[Invert steering direction]' \
'--pedal-invert[Invert forward/backward pedal direction]' \
'--dry-run[Dry run / probe\: inspect devices and diagnostics, do not create virtual gamepad]' \
'--print-config[Print effective configuration as TOML and exit]' \
'--man[Display or export the roff man page and exit]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
}

(( $+functions[_wacom-steer_commands] )) ||
_wacom-steer_commands() {
    local commands; commands=()
    _describe -t commands 'wacom-steer commands' commands "$@"
}

if [ "$funcstack[1]" = "_wacom-steer" ]; then
    _wacom-steer "$@"
else
    compdef _wacom-steer wacom-steer
fi
